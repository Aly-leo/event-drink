generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CLIENT
  DEPOT
  ADMIN
}

enum StatutDepot {
  EN_ATTENTE
  VALIDE
  BLOQUE
}

enum CategorieProduit {
  BIERE_LOCALE
  BIERE_IMPORTEE
  CHAMPAGNE_EFFERVESCENT
  VIN
  SANS_ALCOOL
}

enum ModeReception {
  RETRAIT
  LIVRAISON
}

enum StatutCommande {
  EN_ATTENTE
  CONFIRMEE
  PRETE_A_RETIRER
  EN_PREPARATION
  EN_ROUTE
  TERMINEE
  LIVREE
}

enum StatutConsigne {
  BLOQUEE
  REMBOURSEE
}

enum MotifPlainte {
  REFUS_CONSIGNE
  PRODUIT_MANQUANT
  PRODUIT_ENDOMMAGE
  RETARD_LIVRAISON
  QUALITE_SERVICE
  AUTRE
}

enum StatutPlainte {
  EN_ATTENTE
  RESOLUE
}

enum ActionAdminPlainte {
  AVERTISSEMENT
  SUSPENSION_TEMPORAIRE
  BANNISSEMENT
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  nom       String
  telephone String?
  adresse   String?
  role      Role
  createdAt DateTime @default(now())

  depot       Depot?
  commandes   Commande[]
  plaintes    Plainte[]
  avis        Avis[]
  resetTokens PasswordResetToken[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model Depot {
  id              String      @id @default(cuid())
  ownerId         String      @unique
  owner           User        @relation(fields: [ownerId], references: [id])
  nomCommerce     String
  telephone       String
  adresse         String
  latitude        Float
  longitude       Float
  modeLivraison   Boolean     @default(false)
  modeRetrait     Boolean     @default(true)
  fraisLivraison  Int         @default(0)
  statut          StatutDepot @default(EN_ATTENTE)
  visuelUrl       String?
  createdAt       DateTime    @default(now())

  produits   ProduitDepot[]
  commandes  Commande[]
  plaintes   Plainte[]
  avis       Avis[]
  abonnement Abonnement?

  @@map("depots")
}

model Produit {
  id             String           @id @default(cuid())
  nom            String
  marque         String
  contenance     String
  categorie      CategorieProduit
  visuelUrl      String?
  estConsignable Boolean          @default(false)
  createdAt      DateTime         @default(now())

  depots ProduitDepot[]

  @@map("produits")
}

model ProduitDepot {
  id              String   @id @default(cuid())
  depotId         String
  depot           Depot    @relation(fields: [depotId], references: [id])
  produitId       String
  produit         Produit  @relation(fields: [produitId], references: [id])
  prix            Int
  montantConsigne Int      @default(0)
  disponible      Boolean  @default(true)
  quantiteStock   Int      @default(0)
  seuilAlerte     Int      @default(5)
  createdAt       DateTime @default(now())

  lignesCommande LigneCommande[]
  mouvements     MouvementStock[]

  @@unique([depotId, produitId])
  @@map("produits_depot")
}

enum TypeMouvementStock {
  ENTREE
  SORTIE
}

model MouvementStock {
  id             String             @id @default(cuid())
  produitDepotId String
  produitDepot   ProduitDepot       @relation(fields: [produitDepotId], references: [id])
  type           TypeMouvementStock
  quantite       Int
  motif          String?
  createdAt      DateTime           @default(now())

  @@index([produitDepotId])
  @@map("mouvements_stock")
}

model Commande {
  id              String         @id @default(cuid())
  clientId        String
  client          User           @relation(fields: [clientId], references: [id])
  depotId         String
  depot           Depot          @relation(fields: [depotId], references: [id])
  mode              ModeReception
  statut            StatutCommande @default(EN_ATTENTE)
  montantTotal      Int
  fraisLivraison    Int            @default(0)
  referenceUnique   String         @unique
  adresseLivraison  String?
  instructions      String?
  createdAt         DateTime       @default(now())

  lignes LigneCommande[]
  avis   Avis?

  @@map("commandes")
}

model LigneCommande {
  id                      String       @id @default(cuid())
  commandeId              String
  commande                Commande     @relation(fields: [commandeId], references: [id])
  produitDepotId          String
  produitDepot            ProduitDepot @relation(fields: [produitDepotId], references: [id])
  quantite                Int
  prixUnitaire            Int
  montantConsigneUnitaire Int          @default(0)

  consigne Consigne?

  @@map("lignes_commande")
}

model Consigne {
  id              String          @id @default(cuid())
  ligneCommandeId String          @unique
  ligneCommande   LigneCommande   @relation(fields: [ligneCommandeId], references: [id])
  montant         Int
  statut          StatutConsigne  @default(BLOQUEE)
  createdAt       DateTime        @default(now())

  @@map("consignes")
}

model Plainte {
  id                String              @id @default(cuid())
  clientId          String
  client            User                @relation(fields: [clientId], references: [id])
  depotId           String
  depot             Depot               @relation(fields: [depotId], references: [id])
  referenceCommande String?
  motif             MotifPlainte
  message           String
  photoUrl          String?
  statut            StatutPlainte       @default(EN_ATTENTE)
  actionAdmin       ActionAdminPlainte?
  createdAt         DateTime            @default(now())

  @@map("plaintes")
}

model Avis {
  id          String   @id @default(cuid())
  clientId    String
  client      User     @relation(fields: [clientId], references: [id])
  depotId     String
  depot       Depot    @relation(fields: [depotId], references: [id])
  commandeId  String   @unique
  commande    Commande @relation(fields: [commandeId], references: [id])
  note        Int
  commentaire String?
  createdAt   DateTime @default(now())

  @@map("avis")
}

enum PalierAbonnement {
  STANDARD
  PREMIUM
}

enum StatutAbonnement {
  ACTIF
  EXPIRE
  EN_ATTENTE_PAIEMENT
}

enum StatutPaiement {
  REUSSI
  ECHOUE
}

enum OperateurPaiement {
  ORANGE_MONEY
  MTN_MOMO
}

model Abonnement {
  id                 String           @id @default(cuid())
  depotId            String           @unique
  depot              Depot            @relation(fields: [depotId], references: [id])
  palier             PalierAbonnement @default(STANDARD)
  statut             StatutAbonnement @default(EN_ATTENTE_PAIEMENT)
  dateRenouvellement DateTime?
  createdAt          DateTime         @default(now())

  paiements PaiementAbonnement[]

  @@map("abonnements")
}

model PaiementAbonnement {
  id              String            @id @default(cuid())
  abonnementId    String
  abonnement      Abonnement        @relation(fields: [abonnementId], references: [id])
  palier          PalierAbonnement
  montant         Int
  operateur       OperateurPaiement
  numeroTelephone String
  statut          StatutPaiement
  reference       String            @unique
  createdAt       DateTime          @default(now())

  @@index([abonnementId])
  @@map("paiements_abonnement")
}
