generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CLIENT
  DEPOT
  ADMIN
}

enum StatutDepot {
  EN_ATTENTE
  VALIDE
  BLOQUE
}

enum CategorieProduit {
  BIERE_LOCALE
  BIERE_IMPORTEE
  CHAMPAGNE_EFFERVESCENT
  VIN
  SANS_ALCOOL
}

enum ModeReception {
  RETRAIT
  LIVRAISON
}

enum StatutCommande {
  EN_ATTENTE
  CONFIRMEE
  PRETE_A_RETIRER
  EN_PREPARATION
  EN_ROUTE
  TERMINEE
  LIVREE
}

enum StatutConsigne {
  BLOQUEE
  REMBOURSEE
}

enum MotifPlainte {
  REFUS_CONSIGNE
  PRODUIT_MANQUANT
  PRODUIT_ENDOMMAGE
  RETARD_LIVRAISON
  QUALITE_SERVICE
  AUTRE
}

enum StatutPlainte {
  EN_ATTENTE
  RESOLUE
}

enum ActionAdminPlainte {
  AVERTISSEMENT
  SUSPENSION_TEMPORAIRE
  BANNISSEMENT
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  nom       String
  telephone String?
  adresse   String?
  role      Role
  createdAt DateTime @default(now())

  depot     Depot?
  commandes Commande[]
  plaintes  Plainte[]

  @@map("users")
}

model Depot {
  id              String      @id @default(cuid())
  ownerId         String      @unique
  owner           User        @relation(fields: [ownerId], references: [id])
  nomCommerce     String
  telephone       String
  adresse         String
  latitude        Float
  longitude       Float
  modeLivraison   Boolean     @default(false)
  modeRetrait     Boolean     @default(true)
  fraisLivraison  Int         @default(0)
  statut          StatutDepot @default(EN_ATTENTE)
  visuelUrl       String?
  createdAt       DateTime    @default(now())

  produits  ProduitDepot[]
  commandes Commande[]
  plaintes  Plainte[]

  @@map("depots")
}

model Produit {
  id             String           @id @default(cuid())
  nom            String
  marque         String
  contenance     String
  categorie      CategorieProduit
  visuelUrl      String?
  estConsignable Boolean          @default(false)
  createdAt      DateTime         @default(now())

  depots ProduitDepot[]

  @@map("produits")
}

model ProduitDepot {
  id              String   @id @default(cuid())
  depotId         String
  depot           Depot    @relation(fields: [depotId], references: [id])
  produitId       String
  produit         Produit  @relation(fields: [produitId], references: [id])
  prix            Int
  montantConsigne Int      @default(0)
  disponible      Boolean  @default(true)
  createdAt       DateTime @default(now())

  lignesCommande LigneCommande[]

  @@unique([depotId, produitId])
  @@map("produits_depot")
}

model Commande {
  id              String         @id @default(cuid())
  clientId        String
  client          User           @relation(fields: [clientId], references: [id])
  depotId         String
  depot           Depot          @relation(fields: [depotId], references: [id])
  mode              ModeReception
  statut            StatutCommande @default(EN_ATTENTE)
  montantTotal      Int
  fraisLivraison    Int            @default(0)
  referenceUnique   String         @unique
  adresseLivraison  String?
  instructions      String?
  createdAt         DateTime       @default(now())

  lignes LigneCommande[]

  @@map("commandes")
}

model LigneCommande {
  id                      String       @id @default(cuid())
  commandeId              String
  commande                Commande     @relation(fields: [commandeId], references: [id])
  produitDepotId          String
  produitDepot            ProduitDepot @relation(fields: [produitDepotId], references: [id])
  quantite                Int
  prixUnitaire            Int
  montantConsigneUnitaire Int          @default(0)

  consigne Consigne?

  @@map("lignes_commande")
}

model Consigne {
  id              String          @id @default(cuid())
  ligneCommandeId String          @unique
  ligneCommande   LigneCommande   @relation(fields: [ligneCommandeId], references: [id])
  montant         Int
  statut          StatutConsigne  @default(BLOQUEE)
  createdAt       DateTime        @default(now())

  @@map("consignes")
}

model Plainte {
  id                String              @id @default(cuid())
  clientId          String
  client            User                @relation(fields: [clientId], references: [id])
  depotId           String
  depot             Depot               @relation(fields: [depotId], references: [id])
  referenceCommande String?
  motif             MotifPlainte
  message           String
  photoUrl          String?
  statut            StatutPlainte       @default(EN_ATTENTE)
  actionAdmin       ActionAdminPlainte?
  createdAt         DateTime            @default(now())

  @@map("plaintes")
}
